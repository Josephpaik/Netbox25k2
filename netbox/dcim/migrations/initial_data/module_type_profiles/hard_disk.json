{
    "name": "하드 디스크",
    "schema": {
        "properties": {
            "type": {
                "type": "string",
                "title": "디스크 유형",
                "enum": [
                    "HD",
                    "SSD",
                    "NVME"
                ],
                "default": "SSD"
            },
            "size": {
                "type": "integer",
                "title": "크기 (GB)",
                "description": "원시 디스크 용량"
            },
            "speed": {
                "type": "integer",
                "title": "속도 (RPM)"
            }
        },
        "required": [
            "size"
        ]
    }
}
