{
    "name": "전원 공급 장치",
    "schema": {
        "properties": {
            "input_current": {
                "type": "string",
                "title": "전류 유형",
                "enum": [
                    "AC",
                    "DC"
                ],
                "default": "AC"
            },
            "input_voltage": {
                "type": "integer",
                "title": "전압",
                "default": 120
            },
            "wattage": {
                "type": "integer",
                "title": "전력량",
                "description": "출력 전력 (와트)"
            },
            "hot_swappable": {
                "type": "boolean",
                "title": "핫스왑 가능",
                "default": false
            }
        },
        "required": [
            "input_current",
            "input_voltage"
        ]
    }
}
