# NetBox Production Environment Variables
# =========================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env file to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   source .env  # or use python-dotenv

#########################
#   Required Settings   #
#########################

# Django SECRET_KEY - Must be at least 50 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
NETBOX_SECRET_KEY=your-secret-key-here-at-least-50-characters-long

# PostgreSQL Database Password
NETBOX_DB_PASSWORD=your-database-password


#########################
#   Database Settings   #
#########################

# Database name (default: netbox)
NETBOX_DB_NAME=netbox

# Database user (default: netbox)
NETBOX_DB_USER=netbox

# Database host (default: localhost)
NETBOX_DB_HOST=localhost

# Database port (default: 5432, leave empty for default)
NETBOX_DB_PORT=

# Database connection max age in seconds (default: 300)
NETBOX_DB_CONN_MAX_AGE=300


#########################
#   Redis Settings      #
#########################

# Redis host (default: localhost)
NETBOX_REDIS_HOST=localhost

# Redis port (default: 6379)
NETBOX_REDIS_PORT=6379

# Redis username (optional)
NETBOX_REDIS_USERNAME=

# Redis password (optional)
NETBOX_REDIS_PASSWORD=

# Redis database for tasks (default: 0)
NETBOX_REDIS_TASKS_DB=0

# Redis database for caching (default: 1)
NETBOX_REDIS_CACHING_DB=1

# Enable Redis SSL (default: false)
NETBOX_REDIS_SSL=false


#########################
#   Server Settings     #
#########################

# Allowed hosts - comma separated (default: localhost,127.0.0.1,::1)
NETBOX_ALLOWED_HOSTS=localhost,127.0.0.1

# Debug mode - NEVER enable in production! (default: false)
NETBOX_DEBUG=false

# Base URL path if NetBox is in a subdirectory (default: empty)
NETBOX_BASE_PATH=

# CSRF trusted origins - comma separated (optional)
NETBOX_CSRF_TRUSTED_ORIGINS=


#########################
#   Email Settings      #
#########################

# Email server (default: localhost)
NETBOX_EMAIL_SERVER=localhost

# Email port (default: 25)
NETBOX_EMAIL_PORT=25

# Email username (optional)
NETBOX_EMAIL_USERNAME=

# Email password (optional)
NETBOX_EMAIL_PASSWORD=

# From email address (optional)
NETBOX_EMAIL_FROM=

# Use TLS (default: false)
NETBOX_EMAIL_USE_TLS=false

# Use SSL (default: false)
NETBOX_EMAIL_USE_SSL=false

# Email timeout in seconds (default: 10)
NETBOX_EMAIL_TIMEOUT=10


#########################
#   Security Settings   #
#########################

# Require login to access NetBox (default: true)
NETBOX_LOGIN_REQUIRED=true

# Allow API token retrieval after creation (default: false)
NETBOX_ALLOW_TOKEN_RETRIEVAL=false

# Login timeout in seconds (default: 1209600 = 14 days)
NETBOX_LOGIN_TIMEOUT=1209600

# Keep session alive on each request (default: false)
NETBOX_LOGIN_PERSISTENCE=false


#########################
#   Optional Settings   #
#########################

# Enable Prometheus metrics endpoint (default: false)
NETBOX_METRICS_ENABLED=false

# Background task timeout in seconds (default: 300)
NETBOX_RQ_TIMEOUT=300

# CORS allowed origins - comma separated (optional)
NETBOX_CORS_WHITELIST=

# Allow all CORS origins (default: false)
NETBOX_CORS_ALLOW_ALL=false

# Enabled plugins - comma separated (optional)
NETBOX_PLUGINS=

# Release check URL (optional, set to check for updates)
# NETBOX_RELEASE_CHECK_URL=https://api.github.com/repos/netbox-community/netbox/releases
